/*
 * Builds the Bluetooth host without a controller. The test never calls bt_enable(), so
 * dropping the HCI driver keeps the test runnable on every simulated platform instead of
 * tying it to a board with a radio.
 */
/ {
	chosen {
		/delete-property/ zephyr,bt-hci;
	};
};
